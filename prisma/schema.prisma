generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SALESMAN
  FACTORY_ADMIN
  PRODUCTION_SUPERVISOR
  AUDITOR
  OWNER
}

enum CustomerType {
  RETAILER
  DISTRIBUTOR
}

enum ItemCategory {
  RAW_MATERIAL
  PACKAGING
  FINISHED_GOOD
}

enum UnitType {
  KG
  GRAM
  LITRE
  ML
  PIECE
  PACKET
  CARTON
}

enum ProductionRunStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  SUBMITTED
  APPROVED
  ON_HOLD
  REJECTED
  INVOICED
  DISPATCHED
  CANCELLED
}

enum InvoiceStatus {
  POSTED
  CANCELLED
}

enum DispatchStatus {
  PENDING_DISPATCH
  PARTIALLY_DISPATCHED
  DISPATCHED
}

enum CreditNoteType {
  CANCELLATION
  SALES_RETURN
}

enum ReturnCondition {
  RESALEABLE
  DAMAGED
}

enum GrnStatus {
  PENDING_BILLING
  VERIFIED
  REJECTED
}

enum ResetRequestStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
}

enum MovementType {
  OPENING_BALANCE
  PURCHASE_RECEIPT
  PRODUCTION_ISSUE
  PRODUCTION_OUTPUT
  DISPATCH_SALE
  SALES_RETURN
  SCRAP_DAMAGE
  STOCK_ADJUSTMENT
}

enum RefType {
  OPENING
  PURCHASE
  PRODUCTION_RUN
  INVOICE
  DISPATCH_CHALLAN
  CREDIT_NOTE
  GRN
  ADJUSTMENT
}

enum DocumentType {
  ORDER
  INVOICE
  DISPATCH_CHALLAN
  CREDIT_NOTE
  PRODUCTION_RUN
  PURCHASE
  GRN
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  name                String
  role                Role
  phone               String?
  active              Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  tokenVersion        Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  assignedCustomers     Customer[]             @relation("SalesmanCustomers")
  orders                Order[]                @relation("SalesmanOrders")
  supervisedRuns        ProductionRun[]        @relation("SupervisorRuns")
  createdPurchases      Purchase[]             @relation("PurchaseCreatedBy")
  createdInvoices       Invoice[]              @relation("InvoiceCreatedBy")
  dispatchedInvoices    Invoice[]              @relation("InvoiceDispatchedBy")
  dispatchChallans      DispatchChallan[]      @relation("ChallanDispatchedBy")
  creditNotes           CreditNote[]           @relation("CreditNoteIssuedBy")
  customerPayments      Payment[]              @relation("PaymentRecordedBy")
  supplierPayments      SupplierPayment[]      @relation("SupplierPaymentRecordedBy")
  receivedGrns          GoodsReceipt[]         @relation("GrnReceivedBy")
  verifiedGrns          GoodsReceipt[]         @relation("GrnVerifiedBy")
  passwordResetRequests PasswordResetRequest[]
  stockMovements        StockLedger[]          @relation("LedgerCreatedBy")
  auditLogs             AuditLog[]

  @@index([role, active])
}

model PasswordResetRequest {
  id           String             @id @default(uuid())
  userId       String
  status       ResetRequestStatus @default(PENDING)
  requestedAt  DateTime           @default(now())
  resolvedById String?
  resolvedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model Customer {
  id                 String       @id @default(uuid())
  name               String
  type               CustomerType
  gstin              String?
  state              String
  stateCode          String
  phone              String
  address            String
  creditLimit        Decimal      @default(0) @db.Decimal(12, 2)
  creditDays         Int          @default(30)
  assignedSalesmanId String?
  active             Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  assignedSalesman User?           @relation("SalesmanCustomers", fields: [assignedSalesmanId], references: [id])
  customPrices     CustomerPrice[]
  orders           Order[]
  invoices         Invoice[]
  payments         Payment[]

  @@index([active, assignedSalesmanId])
}

model CustomerPrice {
  id          String   @id @default(uuid())
  customerId  String
  itemId      String
  customPrice Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  item     Item     @relation(fields: [itemId], references: [id])

  @@unique([customerId, itemId])
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  gstin     String?
  state     String
  stateCode String
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases     Purchase[]
  payments      SupplierPayment[]
  goodsReceipts GoodsReceipt[]
}

model Purchase {
  id             String        @id @default(uuid())
  purchaseNumber String        @unique
  supplierId     String
  billNumber     String
  purchaseDate   DateTime      @default(now())
  placeOfSupply  String
  taxableAmount  Decimal       @db.Decimal(12, 2)
  cgstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  sgstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  igstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  paymentStatus  PaymentStatus @default(UNPAID)
  createdById    String
  createdAt      DateTime      @default(now())

  supplier     Supplier          @relation(fields: [supplierId], references: [id])
  createdBy    User              @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  items        PurchaseItem[]
  payments     SupplierPayment[]
  goodsReceipt GoodsReceipt?

  @@index([supplierId, purchaseDate])
  @@index([purchaseDate])
}

model GoodsReceipt {
  id              String    @id @default(uuid())
  grnNumber       String    @unique
  supplierId      String
  challanNumber   String
  receivedDate    DateTime  @default(now())
  status          GrnStatus @default(PENDING_BILLING)
  notes           String?
  receivedById    String
  verifiedById    String?
  verifiedAt      DateTime?
  purchaseId      String?   @unique
  rejectionReason String?
  createdAt       DateTime  @default(now())

  supplier   Supplier           @relation(fields: [supplierId], references: [id])
  receivedBy User               @relation("GrnReceivedBy", fields: [receivedById], references: [id])
  verifiedBy User?              @relation("GrnVerifiedBy", fields: [verifiedById], references: [id])
  purchase   Purchase?          @relation(fields: [purchaseId], references: [id])
  items      GoodsReceiptItem[]

  @@index([status, receivedDate])
}

model GoodsReceiptItem {
  id          String    @id @default(uuid())
  grnId       String
  itemId      String
  quantity    Decimal   @db.Decimal(12, 3)
  unit        UnitType
  batchNumber String?
  expiryDate  DateTime?
  notes       String?

  grn  GoodsReceipt @relation(fields: [grnId], references: [id])
  item Item         @relation(fields: [itemId], references: [id])
}

model PurchaseItem {
  id            String    @id @default(uuid())
  purchaseId    String
  itemId        String
  quantity      Decimal   @db.Decimal(12, 3)
  unit          UnitType
  unitRate      Decimal   @db.Decimal(12, 2)
  taxRate       Decimal   @db.Decimal(5, 2)
  taxableAmount Decimal   @db.Decimal(12, 2)
  taxAmount     Decimal   @db.Decimal(12, 2)
  totalAmount   Decimal   @db.Decimal(12, 2)
  batchNumber   String?
  expiryDate    DateTime?

  purchase   Purchase    @relation(fields: [purchaseId], references: [id])
  item       Item        @relation(fields: [itemId], references: [id])
  stockBatch StockBatch?
}

model SupplierPayment {
  id              String      @id @default(uuid())
  supplierId      String
  purchaseId      String?
  recordedById    String
  paymentDate     DateTime    @default(now())
  amount          Decimal     @db.Decimal(12, 2)
  paymentMode     PaymentMode
  referenceNumber String?
  notes           String?
  createdAt       DateTime    @default(now())

  supplier   Supplier  @relation(fields: [supplierId], references: [id])
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])
  recordedBy User      @relation("SupplierPaymentRecordedBy", fields: [recordedById], references: [id])
}

model Item {
  id              String       @id @default(uuid())
  code            String       @unique
  name            String
  category        ItemCategory
  unit            UnitType
  packWeightGrams Decimal?     @db.Decimal(12, 3)
  unitsPerCarton  Int?
  hsnCode         String
  taxRate         Decimal      @default(5.00) @db.Decimal(5, 2)
  sellingPrice    Decimal?     @db.Decimal(12, 2)
  reorderLevel    Decimal      @default(0.000) @db.Decimal(12, 3)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  boms                  BOM[]                   @relation("FinishedProductBOM")
  bomItems              BOMItem[]
  purchaseItems         PurchaseItem[]
  goodsReceiptItems     GoodsReceiptItem[]
  orderItems            OrderItem[]
  invoiceItems          InvoiceItem[]
  challanItems          DispatchChallanItem[]
  creditNoteItems       CreditNoteItem[]
  productionConsumption ProductionConsumption[]
  stockBatches          StockBatch[]
  stockLedger           StockLedger[]
  customerPrices        CustomerPrice[]

  @@index([active, category])
}

model BOM {
  id               String   @id @default(uuid())
  finishedItemId   String
  name             String
  batchSizeOutput  Decimal  @db.Decimal(12, 3)
  tolerancePercent Decimal  @default(3.00) @db.Decimal(5, 2)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  finishedItem   Item            @relation("FinishedProductBOM", fields: [finishedItemId], references: [id])
  items          BOMItem[]
  productionRuns ProductionRun[]
}

model BOMItem {
  id          String   @id @default(uuid())
  bomId       String
  itemId      String
  standardQty Decimal  @db.Decimal(12, 3)
  unit        UnitType

  bom  BOM  @relation(fields: [bomId], references: [id])
  item Item @relation(fields: [itemId], references: [id])

  @@unique([bomId, itemId])
}

model ProductionRun {
  id                   String              @id @default(uuid())
  runNumber            String              @unique
  bomId                String
  supervisorId         String
  status               ProductionRunStatus @default(COMPLETED)
  batchMultiplier      Decimal             @default(1.000) @db.Decimal(8, 3)
  runDate              DateTime            @default(now())
  completedAt          DateTime?
  plannedOutput        Decimal             @db.Decimal(12, 3)
  actualOutput         Decimal             @default(0.000) @db.Decimal(12, 3)
  yieldVariancePercent Decimal             @default(0.00) @db.Decimal(6, 2)
  varianceFlagged      Boolean             @default(false)
  labourCost           Decimal             @default(0.00) @db.Decimal(12, 2)
  powerGasCost         Decimal             @default(0.00) @db.Decimal(12, 2)
  totalMaterialCost    Decimal             @default(0.00) @db.Decimal(12, 2)
  totalRunCost         Decimal             @default(0.00) @db.Decimal(12, 2)
  costPerPacket        Decimal?            @db.Decimal(12, 2)
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  bom          BOM                     @relation(fields: [bomId], references: [id])
  supervisor   User                    @relation("SupervisorRuns", fields: [supervisorId], references: [id])
  consumptions ProductionConsumption[]
  outputBatch  StockBatch?

  @@index([runDate(sort: Desc)])
  @@index([status, runDate(sort: Desc)])
}

model ProductionConsumption {
  id              String  @id @default(uuid())
  productionRunId String
  itemId          String
  plannedQty      Decimal @db.Decimal(12, 3)
  actualIssuedQty Decimal @db.Decimal(12, 3)
  scrapDamagedQty Decimal @default(0.000) @db.Decimal(12, 3)
  unitCostTotal   Decimal @default(0.00) @db.Decimal(12, 2)
  variancePercent Decimal @default(0.00) @db.Decimal(6, 2)
  varianceFlagged Boolean @default(false)

  productionRun ProductionRun @relation(fields: [productionRunId], references: [id])
  item          Item          @relation(fields: [itemId], references: [id])
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  clientRequestId String?     @unique
  salesmanId      String
  customerId      String
  orderDate       DateTime    @default(now())
  status          OrderStatus @default(SUBMITTED)
  totalAmount     Decimal     @db.Decimal(12, 2)
  notes           String?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  salesman User        @relation("SalesmanOrders", fields: [salesmanId], references: [id])
  customer Customer    @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  invoice  Invoice?

  @@index([status, orderDate(sort: Desc)])
  @@index([salesmanId, orderDate(sort: Desc)])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  itemId      String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id])
  item  Item  @relation(fields: [itemId], references: [id])
}

model Invoice {
  id                String         @id @default(uuid())
  invoiceNumber     String         @unique
  orderId           String         @unique
  customerId        String
  createdById       String
  invoiceDate       DateTime       @default(now())
  dueDate           DateTime
  placeOfSupply     String
  placeOfSupplyCode String
  taxableAmount     Decimal        @db.Decimal(12, 2)
  cgstAmount        Decimal        @default(0.00) @db.Decimal(12, 2)
  sgstAmount        Decimal        @default(0.00) @db.Decimal(12, 2)
  igstAmount        Decimal        @default(0.00) @db.Decimal(12, 2)
  totalAmount       Decimal        @db.Decimal(12, 2)
  paidAmount        Decimal        @default(0.00) @db.Decimal(12, 2)
  paymentStatus     PaymentStatus  @default(UNPAID)
  status            InvoiceStatus  @default(POSTED)
  dispatchStatus    DispatchStatus @default(PENDING_DISPATCH)
  dispatchedAt      DateTime?
  dispatchedById    String?
  eInvoiceMeta      Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order            Order             @relation(fields: [orderId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  createdBy        User              @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  dispatchedBy     User?             @relation("InvoiceDispatchedBy", fields: [dispatchedById], references: [id])
  items            InvoiceItem[]
  dispatchChallans DispatchChallan[]
  payments         Payment[]
  creditNotes      CreditNote[]

  @@index([customerId, invoiceDate])
  @@index([status, invoiceDate])
  @@index([status, dispatchStatus])
  @@index([status, paymentStatus])
}

model InvoiceItem {
  id            String  @id @default(uuid())
  invoiceId     String
  itemId        String
  hsnCode       String
  quantity      Decimal @db.Decimal(12, 3)
  dispatchedQty Decimal @default(0.000) @db.Decimal(12, 3)
  unitPrice     Decimal @db.Decimal(12, 2)
  taxRate       Decimal @db.Decimal(5, 2)
  taxableAmount Decimal @db.Decimal(12, 2)
  cgstAmount    Decimal @default(0.00) @db.Decimal(12, 2)
  sgstAmount    Decimal @default(0.00) @db.Decimal(12, 2)
  igstAmount    Decimal @default(0.00) @db.Decimal(12, 2)
  totalAmount   Decimal @db.Decimal(12, 2)

  invoice         Invoice               @relation(fields: [invoiceId], references: [id])
  item            Item                  @relation(fields: [itemId], references: [id])
  challanItems    DispatchChallanItem[]
  creditNoteItems CreditNoteItem[]
}

model DispatchChallan {
  id             String   @id @default(uuid())
  challanNumber  String   @unique
  invoiceId      String
  dispatchedById String
  dispatchedAt   DateTime @default(now())
  vehicleNumber  String?
  notes          String?

  invoice      Invoice               @relation(fields: [invoiceId], references: [id])
  dispatchedBy User                  @relation("ChallanDispatchedBy", fields: [dispatchedById], references: [id])
  items        DispatchChallanItem[]

  @@index([invoiceId, dispatchedAt])
}

model DispatchChallanItem {
  id            String  @id @default(uuid())
  challanId     String
  invoiceItemId String
  itemId        String
  quantity      Decimal @db.Decimal(12, 3)

  challan     DispatchChallan @relation(fields: [challanId], references: [id])
  invoiceItem InvoiceItem     @relation(fields: [invoiceItemId], references: [id])
  item        Item            @relation(fields: [itemId], references: [id])
}

model CreditNote {
  id               String         @id @default(uuid())
  creditNoteNumber String         @unique
  invoiceId        String
  type             CreditNoteType @default(CANCELLATION)
  taxableAmount    Decimal        @db.Decimal(12, 2)
  cgstAmount       Decimal        @default(0.00) @db.Decimal(12, 2)
  sgstAmount       Decimal        @default(0.00) @db.Decimal(12, 2)
  igstAmount       Decimal        @default(0.00) @db.Decimal(12, 2)
  amount           Decimal        @db.Decimal(12, 2)
  restocked        Boolean        @default(false)
  reason           String
  issuedById       String
  issuedAt         DateTime       @default(now())

  invoice  Invoice          @relation(fields: [invoiceId], references: [id])
  issuedBy User             @relation("CreditNoteIssuedBy", fields: [issuedById], references: [id])
  items    CreditNoteItem[]
}

model CreditNoteItem {
  id            String          @id @default(uuid())
  creditNoteId  String
  invoiceItemId String?
  itemId        String
  returnedQty   Decimal         @db.Decimal(12, 3)
  condition     ReturnCondition @default(RESALEABLE)
  unitPrice     Decimal         @db.Decimal(12, 2)
  taxRate       Decimal         @db.Decimal(5, 2)
  taxableAmount Decimal         @db.Decimal(12, 2)
  cgstAmount    Decimal         @default(0.00) @db.Decimal(12, 2)
  sgstAmount    Decimal         @default(0.00) @db.Decimal(12, 2)
  igstAmount    Decimal         @default(0.00) @db.Decimal(12, 2)
  totalAmount   Decimal         @db.Decimal(12, 2)

  creditNote  CreditNote   @relation(fields: [creditNoteId], references: [id])
  invoiceItem InvoiceItem? @relation(fields: [invoiceItemId], references: [id])
  item        Item         @relation(fields: [itemId], references: [id])
}

model Payment {
  id              String      @id @default(uuid())
  customerId      String
  invoiceId       String?
  recordedById    String
  paymentDate     DateTime    @default(now())
  amount          Decimal     @db.Decimal(12, 2)
  paymentMode     PaymentMode
  referenceNumber String?
  notes           String?
  createdAt       DateTime    @default(now())

  customer   Customer @relation(fields: [customerId], references: [id])
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  recordedBy User     @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([customerId, paymentDate])
  @@index([paymentDate])
}

model StockBatch {
  id              String    @id @default(uuid())
  batchNumber     String    @unique
  itemId          String
  purchaseItemId  String?   @unique
  productionRunId String?   @unique
  receivedDate    DateTime  @default(now())
  expiryDate      DateTime?
  initialQty      Decimal   @db.Decimal(12, 3)
  remainingQty    Decimal   @db.Decimal(12, 3)
  unitRate        Decimal   @db.Decimal(12, 2)
  createdAt       DateTime  @default(now())

  item          Item           @relation(fields: [itemId], references: [id])
  purchaseItem  PurchaseItem?  @relation(fields: [purchaseItemId], references: [id])
  productionRun ProductionRun? @relation(fields: [productionRunId], references: [id])
  ledgerEntries StockLedger[]

  @@index([itemId, receivedDate])
  @@index([itemId, expiryDate])
  @@index([remainingQty])
  @@index([expiryDate])
}

model StockLedger {
  id            String       @id @default(uuid())
  timestamp     DateTime     @default(now())
  itemId        String
  batchId       String?
  movementType  MovementType
  quantity      Decimal      @db.Decimal(12, 3)
  unit          UnitType
  referenceType RefType
  referenceId   String
  balanceAfter  Decimal      @db.Decimal(12, 3)
  unitRate      Decimal?     @db.Decimal(12, 2)
  totalValue    Decimal?     @db.Decimal(12, 2)
  createdById   String?
  notes         String?

  item      Item        @relation(fields: [itemId], references: [id])
  batch     StockBatch? @relation(fields: [batchId], references: [id])
  createdBy User?       @relation("LedgerCreatedBy", fields: [createdById], references: [id])

  @@index([itemId, timestamp(sort: Desc)])
  @@index([referenceType, referenceId])
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  userId     String
  changes    Json?
  reason     String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model CompanySettings {
  id                      String   @id @default("default")
  companyName             String
  gstin                   String
  state                   String
  stateCode               String
  address                 String
  phone                   String?
  bankDetails             String?
  defaultTolerancePercent Decimal  @default(3.00) @db.Decimal(5, 2)
  isConfigured            Boolean  @default(false)
  updatedAt               DateTime @updatedAt
}

model DocumentSequence {
  id            String       @id @default(uuid())
  docType       DocumentType
  financialYear String
  lastSequence  Int          @default(0)

  @@unique([docType, financialYear])
}
