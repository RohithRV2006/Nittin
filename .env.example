# PostgreSQL Connection (Neon Serverless or Local Docker Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nittin_erp?sslmode=disable"

# Cryptographic secret for signing session JWTs (generate a 32+ char random string in production)
SESSION_SECRET="replace-with-a-strong-64-char-random-secret-for-production-use"

# Demo Mode Control:
# Set to "true" ONLY in evaluation/staging environments to expose the 1-click demo switcher
# and Section 5 Benchmark demo dataset controls. Keep "false" in production.
ENABLE_DEMO_MODE="false"

# Production Bootstrap Admin (used by `npm run db:seed` for clean production initialization)
BOOTSTRAP_ADMIN_EMAIL="admin@factory.local"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMeImmediately!2026"
BOOTSTRAP_ADMIN_NAME="Factory Admin"
